# Copy to `.env.local` for local development, and enter the same names in Vercel (Settings > Environment Variables).
# NEXT_PUBLIC_ values are baked in when the site is built, so redeploy after changing them.

# The API's address plus /api, with nothing after it.
#   local:       http://localhost:8000/api
#   production:  https://YOUR-SERVER.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Clerk (sign-in). Use the live keys in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret: only set it in Vercel's environment variables or .env.local, never in a NEXT_PUBLIC_ name.
CLERK_SECRET_KEY=
