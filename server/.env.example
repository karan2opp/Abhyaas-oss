# Copy this file to `.env` for local development, and enter the same names in Render's Environment tab for production.
# Never commit a real `.env` and never put real values in this file. Values below are placeholders.

# ── Required ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Postgres (Neon). Use the DIRECT connection (host without "-pooler"). The server runs its database migrations on every start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Redis (Upstash), used by the grading queue. Use the TCP address that starts with rediss://, not the REST address.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# The website's address, no trailing slash. Used for CORS. Several can be given, comma separated.
FRONTEND_URL=https://your-app.vercel.app

# Clerk (sign-in). Use the live keys in production. The website needs the same two (see client/.env.example).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Who pays for AI. "byok": each teacher saves their own OpenAI key (the server's OPENAI_API_KEY is not used for them).
# "server": everything runs on OPENAI_API_KEY and the plans and quotas apply.
AI_KEY_MODE=byok

# Encrypts the keys teachers save. Make it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret, use a new one for production, and NEVER change it while keys are saved (they could no longer be read).
AI_KEY_ENCRYPTION_SECRET=

# ── Needed for these features ──────────────────────────────────────────────────────────────────────────────────────
# Used when AI_KEY_MODE=server, and for work that has no teacher's key.
OPENAI_API_KEY=

# Qdrant Cloud: past-paper / question-bank search.
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Cloudinary: stored PDFs and images. The free plan refuses files over 10 MB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inngest Cloud: background jobs. After the first deploy, sync the app in Inngest Cloud to  <server address>/api/inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Optional ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Cashfree payments. Left empty, online payments are "not set up" and everything else works. Start with sandbox.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# The public https address Cashfree calls on a successful payment, e.g. https://YOUR-SERVER.onrender.com/api/payments/webhook
CASHFREE_WEBHOOK_URL=

MISTRAL_API_KEY=
MEM0_API_KEY=
# MEM0_API_URL=https://api.mem0.ai/v3

# AI models. Leave these out to use the defaults (gpt-5.6-luna for everything except embeddings and voice).
# GENERATION_MODEL=gpt-5.6-luna
# EVALUATION_MODEL=gpt-5.6-luna
# GUARDRAIL_MODEL=gpt-5.6-luna
# EMBEDDING_MODEL=text-embedding-3-small
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# ── Local development only. Do NOT set these on Render ─────────────────────────────────────────────────────────────
# PORT=8000                   # Render sets PORT itself
# NODE_ENV=development        # the Dockerfile sets production
# PYTHON_BIN=python           # the Dockerfile points this at its own Python
# INNGEST_DEV=1               # points Inngest at the local dev server; it would break background jobs in production
# POSTGRES_USER=              # used by docker-compose for the local database
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_PORT=
