{
  "name": "auth",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n app,inngest -c blue,magenta --kill-others-on-fail \"npm:dev:app\" \"npm:inngest:dev\"",
    "dev:app": "tsc-watch --onSuccess \"node ./dist/src/index.js\"",
    "build": "tsc --noCheck --declaration false --declarationMap false --sourceMap false",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/src/index.js",
    "studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docker:up": "docker compose -f ../docker-compose.yml --env-file .env up -d",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:8001/api/inngest",
    "dev:all": "npm run dev"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clerk/express": "^2.1.86",
    "@paralleldrive/cuid2": "^3.3.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "bullmq": "^6.1.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "inngest": "^4.18.1",
    "ioredis": "^5.11.1",
    "multer": "^2.1.1",
    "openai": "^6.44.0",
    "p-limit": "^7.3.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
